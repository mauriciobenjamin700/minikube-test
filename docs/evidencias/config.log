$ kubectl describe deploy mangalivre-app | sed -n "/Containers:/,/Mounts:/p"
  Containers:
   mangalivre-app:
    Image:      mangalivre-app:latest
    Port:       3000/TCP
    Host Port:  0/TCP
    Limits:
      cpu:     500m
      memory:  512Mi
    Requests:
      cpu:      200m
      memory:   128Mi
    Liveness:   http-get http://:3000/api/health delay=10s timeout=5s period=5s successThreshold=1 failureThreshold=3
    Readiness:  http-get http://:3000/api/health delay=5s timeout=5s period=5s successThreshold=1 failureThreshold=3
    Environment:
      DB_USER:                mangalivre
      DB_PASSWORD:            mangalivre
      DB_HOST:                mangalivre-db
      DB_PORT:                5432
      DB_NAME:                mangalivre
      ENABLE_CRASH_ENDPOINT:  true
    Mounts:                   <none>
